{
  "name": "smart-desk-deyaco",
  "version": "0.1.0",
  "description": "Smart Desk — Vue/Quasar front-end for the Deyaco ERP",
  "productName": "اسمارت دسک",
  "author": "sobhankhamesi <sobhankhamesi@deyaco.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,vue,css,html,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,vue,css,html,md,json}\"",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "axios": "^1.18.0",
    "pinia": "^4.0.2",
    "quasar": "^2.31.0",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.8.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.8",
    "postcss-rtlcss": "^6.0.0",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
